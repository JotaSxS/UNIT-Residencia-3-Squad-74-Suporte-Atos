# Copie para .env.local (opcional)
VITE_API_URL=https://localhost:7099
# JWT apenas em memória. A restauração utiliza o cookie HttpOnly do backend.
# O Vite lê por padrão ~/.aspnet/https/supportatos-frontend.pem e .key.
# Overrides opcionais, apenas no servidor Vite (não usar prefixo VITE_):
# SUPPORTATOS_HTTPS_CERT=C:/caminho/fora-do-repositorio/certificado.pem
# SUPPORTATOS_HTTPS_KEY=C:/caminho/fora-do-repositorio/certificado.key
